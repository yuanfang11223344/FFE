  <diagram id="RTL_每拍处理" name="RTL 每拍处理">
    <mxGraphModel dx="1760" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="RTL 每拍处理" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=26;fontStyle=1;fontColor=#18324A;" vertex="1" parent="1">
          <mxGeometry x="35" y="18" width="1690" height="44" as="geometry" />
        </mxCell>
        <mxCell id="3" value="要点：乘加不是多拍流水。输入在上升沿被接收，输出在同一上升沿之后更新；持续有效时每拍一个样本。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=15;fontColor=#52616F;" vertex="1" parent="1">
          <mxGeometry x="40" y="65" width="1680" height="38" as="geometry" />
        </mxCell>
        <mxCell id="4" value="本周期稳定的 x_in 与 d1..d4&#10;→ 5 个常数乘法&#10;→ 19 位累加 acc&#10;→ 算术右移 6 位&#10;→ 饱和器得到 quantized" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;shadow=0;fillColor=#E8F1FB;strokeColor=#4C78A8;strokeWidth=2;fontFamily=PingFang SC;fontSize=15;fontColor=#203040;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="165" width="455" height="250" as="geometry" />
        </mxCell>
        <mxCell id="5" value="posedge clk&#10;检查 rst_n&#10;&#10;若 rst_n=0：异步清零状态&#10;否则：out_valid &lt;= in_valid" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;shadow=0;fillColor=#F0EAFE;strokeColor=#8064A2;strokeWidth=2;fontFamily=PingFang SC;fontSize=15;fontColor=#203040;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="645" y="190" width="400" height="200" as="geometry" />
        </mxCell>
        <mxCell id="6" value="in_valid == 1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;shadow=0;fillColor=#FFF1DF;strokeColor=#D68A24;strokeWidth=2;fontFamily=PingFang SC;fontSize=15;fontColor=#203040;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="800" y="455" width="220" height="110" as="geometry" />
        </mxCell>
        <mxCell id="7" value="同一个上升沿：&#10;y_out &lt;= quantized&#10;d1 &lt;= x_in&#10;d2 &lt;= 旧 d1&#10;d3 &lt;= 旧 d2&#10;d4 &lt;= 旧 d3&#10;out_valid = 1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;shadow=0;fillColor=#E5F5F2;strokeColor=#2A8C82;strokeWidth=2;fontFamily=PingFang SC;fontSize=15;fontColor=#203040;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1190" y="170" width="450" height="265" as="geometry" />
        </mxCell>
        <mxCell id="8" value="同一个上升沿：&#10;历史寄存器保持&#10;y_out 保持&#10;out_valid = 0&#10;组合 acc 仍可随输入变化" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;shadow=0;fillColor=#F1F3F5;strokeColor=#77818B;strokeWidth=2;fontFamily=PingFang SC;fontSize=15;fontColor=#203040;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1190" y="520" width="450" height="230" as="geometry" />
        </mxCell>
        <mxCell id="9" value="quantized 在沿前就绪" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#607D8B;strokeWidth=2;endArrow=block;endFill=1;fontFamily=PingFang SC;fontSize=13;fontColor=#37474F;" edge="1" parent="1" source="4" target="5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="10" value="时钟沿" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#607D8B;strokeWidth=2;endArrow=block;endFill=1;fontFamily=PingFang SC;fontSize=13;fontColor=#37474F;" edge="1" parent="1" source="5" target="6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="11" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#607D8B;strokeWidth=2;endArrow=block;endFill=1;fontFamily=PingFang SC;fontSize=13;fontColor=#37474F;" edge="1" parent="1" source="6" target="7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="12" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#607D8B;strokeWidth=2;endArrow=block;endFill=1;fontFamily=PingFang SC;fontSize=13;fontColor=#37474F;" edge="1" parent="1" source="6" target="8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="13" value="rst_n 为低时不等待时钟：立即清零 d1..d4、y_out、out_valid。释放复位后，历史零值等价于有效输入序列前补零。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;shadow=0;fillColor=#FDECEC;strokeColor=#C65A5A;strokeWidth=2;fontFamily=PingFang SC;fontSize=15;fontColor=#203040;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="600" width="970" height="150" as="geometry" />
        </mxCell>
        <mxCell id="14" value="接受输入的时钟沿后输出寄存器立即更新（不额外等待一个完整周期）；out_valid 与该结果对齐。无 ready/反压端口；in_valid=0 是暂停状态更新的气泡。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;shadow=0;fillColor=#E8F1FB;strokeColor=#4C78A8;strokeWidth=2;fontFamily=PingFang SC;fontSize=15;fontColor=#203040;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="785" width="1570" height="72" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
