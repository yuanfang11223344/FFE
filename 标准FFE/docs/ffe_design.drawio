        <mxCell id="30" value="符号扩展至 19 位&#10;五路求和得到 acc" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;shadow=0;fillColor=#E8F1FB;strokeColor=#4C78A8;strokeWidth=2;fontFamily=PingFang SC;fontSize=15;fontColor=#203040;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1150" y="450" width="190" height="130" as="geometry" />
