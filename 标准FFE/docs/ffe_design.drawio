        <mxCell id="37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#607D8B;strokeWidth=2;endArrow=block;endFill=1;fontFamily=PingFang SC;fontSize=13;fontColor=#37474F;" edge="1" parent="1" source="32" target="33">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="38" value="D0=x_in（当前样本）；D1=d1 到 D4=d4（从新到旧的历史样本），不是乘法器内部流水级。&#10;一个有效上升沿：y_out 锁存沿前 D0..D4 的计算结果，同时 D0→D1→D2→D3→D4 推进；气泡时 D1..D4 与 y_out 保持，out_valid 拉低。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;shadow=0;fillColor=#F1F3F5;strokeColor=#77818B;strokeWidth=2;fontFamily=PingFang SC;fontSize=15;fontColor=#203040;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
