  <diagram id="RTL_每拍处理" name="RTL 每拍处理">
    <mxGraphModel dx="1760" dy="1010" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="1010" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="RTL 每拍处理" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=26;fontStyle=1;fontColor=#18324A;" vertex="1" parent="1">
          <mxGeometry x="35" y="18" width="1690" height="44" as="geometry" />
        </mxCell>
        <mxCell id="3" value="颜色按时钟拍分组：同一行同色的状态、组合运算和时钟沿更新属于同一拍；下一拍换色。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=15;fontColor=#52616F;" vertex="1" parent="1">
          <mxGeometry x="40" y="65" width="1680" height="38" as="geometry" />
        </mxCell>
        <mxCell id="4" value="每个颜色代表一整拍，包含“本拍开始状态 → 沿前组合计算 → 本拍上升沿更新”。D0..D4 是样本延迟位置，不是运算要经过的多拍流水级。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;shadow=0;fillColor=#F1F3F5;strokeColor=#77818B;strokeWidth=2;fontFamily=PingFang SC;fontSize=15;fontColor=#203040;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="115" width="1675" height="58" as="geometry" />
        </mxCell>
        <mxCell id="5" value="in_valid = 1&#10;D0 = x[n]&#10;D1 = x[n−1]&#10;D2 = x[n−2]&#10;D3 = x[n−3]&#10;D4 = x[n−4]" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;shadow=0;fillColor=#E8F1FB;strokeColor=#4C78A8;strokeWidth=2;fontFamily=PingFang SC;fontSize=15;fontColor=#203040;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="45" y="200" width="430" height="230" as="geometry" />
        </mxCell>
        <mxCell id="6" value="p0..p4 = C0..C4 × D0..D4&#10;acc[n] = p0 + p1 + p2 + p3 + p4&#10;quantized[n] = sat(acc[n] &gt;&gt;&gt; 6)&#10;这些值在上升沿前稳定" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;shadow=0;fillColor=#E8F1FB;strokeColor=#4C78A8;strokeWidth=2;fontFamily=PingFang SC;fontSize=15;fontColor=#203040;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="560" y="200" width="510" height="230" as="geometry" />
        </mxCell>
        <mxCell id="7" value="posedge clk：&#10;y_out &lt;= quantized[n]&#10;out_valid &lt;= 1&#10;D1 &lt;= D0；D2 &lt;= 旧 D1&#10;D3 &lt;= 旧 D2；D4 &lt;= 旧 D3&#10;本沿输出和历史同时更新" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;shadow=0;fillColor=#E8F1FB;strokeColor=#4C78A8;strokeWidth=2;fontFamily=PingFang SC;fontSize=15;fontColor=#203040;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1155" y="200" width="540" height="230" as="geometry" />
        </mxCell>
        <mxCell id="8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4C78A8;strokeWidth=2;endArrow=block;endFill=1;fontFamily=PingFang SC;fontSize=13;fontColor=#37474F;" edge="1" parent="1" source="5" target="6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4C78A8;strokeWidth=2;endArrow=block;endFill=1;fontFamily=PingFang SC;fontSize=13;fontColor=#37474F;" edge="1" parent="1" source="6" target="7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="10" value="in_valid = 1&#10;D0 = x[n+1]&#10;D1 = x[n]&#10;D2 = x[n−1]&#10;D3 = x[n−2]&#10;D4 = x[n−3]" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;shadow=0;fillColor=#FFF1DF;strokeColor=#D68A24;strokeWidth=2;fontFamily=PingFang SC;fontSize=15;fontColor=#203040;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="45" y="485" width="430" height="230" as="geometry" />
        </mxCell>
        <mxCell id="11" value="用新的 D0..D4&#10;执行相同的五路乘法、累加、&#10;算术右移和饱和&#10;得到 quantized[n+1]" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;shadow=0;fillColor=#FFF1DF;strokeColor=#D68A24;strokeWidth=2;fontFamily=PingFang SC;fontSize=15;fontColor=#203040;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="560" y="485" width="510" height="230" as="geometry" />
        </mxCell>
        <mxCell id="12" value="posedge clk：&#10;y_out &lt;= quantized[n+1]&#10;out_valid &lt;= 1&#10;D1..D4 再向历史方向推进一格&#10;持续有效时每拍接受一个样本" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;shadow=0;fillColor=#FFF1DF;strokeColor=#D68A24;strokeWidth=2;fontFamily=PingFang SC;fontSize=15;fontColor=#203040;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1155" y="485" width="540" height="230" as="geometry" />
        </mxCell>
        <mxCell id="13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#D68A24;strokeWidth=2;endArrow=block;endFill=1;fontFamily=PingFang SC;fontSize=13;fontColor=#37474F;" edge="1" parent="1" source="10" target="11">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#D68A24;strokeWidth=2;endArrow=block;endFill=1;fontFamily=PingFang SC;fontSize=13;fontColor=#37474F;" edge="1" parent="1" source="11" target="12">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="15" value="若某拍 in_valid=0：out_valid 拉低；D1..D4 与 y_out 保持；组合 acc 仍会随 x_in 变化。该拍不消费新样本，后续有效样本仍按有效样本顺序推进。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;shadow=0;fillColor=#F1F3F5;strokeColor=#77818B;strokeWidth=2;fontFamily=PingFang SC;fontSize=15;fontColor=#203040;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="45" y="770" width="795" height="130" as="geometry" />
        </mxCell>
        <mxCell id="16" value="rst_n 拉低时立即清零 D1..D4、y_out、out_valid。有效样本在其采样上升沿后得到对应输出，持续有效时吞吐为每拍一个样本；没有额外的 MAC 流水等待。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;shadow=0;fillColor=#FDECEC;strokeColor=#C65A5A;strokeWidth=2;fontFamily=PingFang SC;fontSize=15;fontColor=#203040;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="885" y="770" width="810" height="130" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="Python_函数职责图" name="Python 函数职责图">
    <mxGraphModel dx="2340" dy="1180" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2340" pageHeight="1180" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="Python 函数职责图" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=26;fontStyle=1;fontColor=#18324A;" vertex="1" parent="1">
          <mxGeometry x="35" y="18" width="2270" height="44" as="geometry" />
        </mxCell>
        <mxCell id="3" value="按源码真实函数分组；FFE.step 是位精确模型核心，其它模块负责向量生成、RTL 回归、作图和教学信道卷积。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=15;fontColor=#52616F;" vertex="1" parent="1">
          <mxGeometry x="40" y="65" width="2260" height="38" as="geometry" />
        </mxCell>
        <mxCell id="4" value="参考模型：ffe.py" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;shadow=0;fillColor=#E8F1FB;strokeColor=#4C78A8;strokeWidth=2;fontFamily=PingFang SC;fontSize=15;fontColor=#203040;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="35" y="120" width="720" height="46" as="geometry" />
        </mxCell>
        <mxCell id="5" value="signed_range(width)：计算有符号范围&#10;arithmetic_shift(value, amount)：模拟 RTL 算术右移&#10;saturate(value, width)：饱和限幅" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;shadow=0;fillColor=#E8F1FB;strokeColor=#4C78A8;strokeWidth=2;fontFamily=PingFang SC;fontSize=15;fontColor=#203040;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="55" y="190" width="680" height="145" as="geometry" />
        </mxCell>
        <mxCell id="6" value="FFE.__post_init__()：检查 5 个系数及系数位宽，再清零状态&#10;FFE.accumulator_width：计算乘积累加所需位宽" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;shadow=0;fillColor=#E5F5F2;strokeColor=#2A8C82;strokeWidth=2;fontFamily=PingFang SC;fontSize=15;fontColor=#203040;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="55" y="355" width="680" height="110" as="geometry" />
        </mxCell>
        <mxCell id="7" value="FFE.reset()：history=[0,0,0,0]，output=0&#10;FFE.step(sample, valid)：组 taps → 乘系数 → 求和 → 右移 → 饱和；valid 时更新 history/output&#10;FFE.process(samples)：连续有效处理并收集输出" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;shadow=0;fillColor=#FFF1DF;strokeColor=#D68A24;strokeWidth=2;fontFamily=PingFang SC;fontSize=15;fontColor=#203040;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="55" y="485" width="680" height="185" as="geometry" />
        </mxCell>
        <mxCell id="8" value="demo_samples(seed)：确定性生成 296 个输入&#10;write_vectors(path, samples, model)：写 taps / products / acc / y CSV&#10;main()：解析 --csv、调用生成器与写出函数" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;shadow=0;fillColor=#F0EAFE;strokeColor=#8064A2;strokeWidth=2;fontFamily=PingFang SC;fontSize=15;fontColor=#203040;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="55" y="690" width="680" height="145" as="geometry" />
        </mxCell>
        <mxCell id="9" value="仿真编排：scripts/run.py" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;shadow=0;fillColor=#E5F5F2;strokeColor=#2A8C82;strokeWidth=2;fontFamily=PingFang SC;fontSize=15;fontColor=#203040;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="800" y="120" width="720" height="46" as="geometry" />
        </mxCell>
        <mxCell id="10" value="显示并执行子进程命令；cwd 固定在工程根目录，失败即退出。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;shadow=0;fillColor=#E5F5F2;strokeColor=#2A8C82;strokeWidth=2;fontFamily=PingFang SC;fontSize=15;fontColor=#203040;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="820" y="190" width="680" height="85" as="geometry" />
        </mxCell>
        <mxCell id="11" value="把 wave.csv 的输入、Python 期望、RTL 输出和累加器画成波形 SVG。&#10;内部 x() / yv() / ya() 做坐标映射；poly() 生成曲线点列。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;shadow=0;fillColor=#E8F1FB;strokeColor=#4C78A8;strokeWidth=2;fontFamily=PingFang SC;fontSize=15;fontColor=#203040;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="820" y="295" width="680" height="130" as="geometry" />
        </mxCell>
        <mxCell id="12" value="检查 COUNT 契约 → 生成 CSV/MEM → 编译并运行 Icarus → 检查每拍输出、气泡和 acc → 生成波形与信道图。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;shadow=0;fillColor=#FFF1DF;strokeColor=#D68A24;strokeWidth=2;fontFamily=PingFang SC;fontSize=15;fontColor=#203040;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="820" y="445" width="680" height="135" as="geometry" />
        </mxCell>
        <mxCell id="13" value="demo_samples / write_vectors / FFE.step&#10;→ iverilog + vvp 执行 tb_ffe&#10;→ 检查 wave.csv 与 ffe.vcd&#10;→ make_svg + write_demo" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;shadow=0;fillColor=#F0EAFE;strokeColor=#8064A2;strokeWidth=2;fontFamily=PingFang SC;fontSize=15;fontColor=#203040;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="820" y="600" width="680" height="145" as="geometry" />
        </mxCell>
        <mxCell id="14" value="教学卷积：scripts/channel_demo.py" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;shadow=0;fillColor=#F0EAFE;strokeColor=#8064A2;strokeWidth=2;fontFamily=PingFang SC;fontSize=15;fontColor=#203040;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1565" y="120" width="730" height="46" as="geometry" />
        </mxCell>
        <mxCell id="15" value="计算两个有限离散序列的线性卷积；说明信道与均衡器级联响应。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;shadow=0;fillColor=#E8F1FB;strokeColor=#4C78A8;strokeWidth=2;fontFamily=PingFang SC;fontSize=15;fontColor=#203040;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1585" y="190" width="690" height="90" as="geometry" />
        </mxCell>
        <mxCell id="16" value="计算非主抽头能量 / 主抽头能量；只用于教学示例内对比。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;shadow=0;fillColor=#E5F5F2;strokeColor=#2A8C82;strokeWidth=2;fontFamily=PingFang SC;fontSize=15;fontColor=#203040;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1585" y="300" width="690" height="90" as="geometry" />
        </mxCell>
        <mxCell id="17" value="设置假设信道 → 卷积 → 计算前后比例 → 输出 channel.csv 和 channel.svg。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;shadow=0;fillColor=#FFF1DF;strokeColor=#D68A24;strokeWidth=2;fontFamily=PingFang SC;fontSize=15;fontColor=#203040;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1585" y="410" width="690" height="120" as="geometry" />
        </mxCell>
        <mxCell id="18" value="test_rtl_default_parameters_match_reference：核对 RTL 参数/系数&#10;test_impulse_response：核对冲激响应&#10;test_against_independent_convolution：独立卷积交叉验证&#10;test_invalid_cycle_matches_rtl_hold_behavior：核对气泡保持&#10;test_reset_and_bounds：核对复位、位宽边界与饱和&#10;脚本入口调用 unittest.main()" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;shadow=0;fillColor=#FDECEC;strokeColor=#C65A5A;strokeWidth=2;fontFamily=PingFang SC;fontSize=15;fontColor=#203040;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1585" y="560" width="690" height="200" as="geometry" />
        </mxCell>
        <mxCell id="19" value="先看 FFE.step 理解单个采样怎样被均衡；再看 run.py/main 理解 Python 如何驱动 RTL 回归；最后看 channel_demo 的连续信道卷积。create_diagrams.py：Page.__init__ 建页，card/edge 放图元，xml 序列化；四个 builder 组图，locate_drawio/main 生成 draw.io 并导出 SVG。完整软硬件调用关系见下一页。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;shadow=0;fillColor=#F1F3F5;strokeColor=#77818B;strokeWidth=2;fontFamily=PingFang SC;fontSize=15;fontColor=#203040;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="55" y="890" width="2220" height="130" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
