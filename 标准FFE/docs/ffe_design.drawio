        <mxCell id="11" value="scripts/run.py&#10;有效周期：RTL y == Python expected&#10;所有周期：状态输出/组合 acc 符合模型&#10;任一不符即断言失败" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;shadow=0;fillColor=#FDECEC;strokeColor=#C65A5A;strokeWidth=2;fontFamily=PingFang SC;fontSize=15;fontColor=#203040;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
