        <mxCell id="9" value="rtl/ffe.sv&#10;五路常数乘法 → 累加&#10;缩放 → 饱和 → 输出寄存器" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;shadow=0;fillColor=#FFF1DF;strokeColor=#D68A24;strokeWidth=2;fontFamily=PingFang SC;fontSize=15;fontColor=#203040;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1570" y="205" width="350" height="160" as="geometry" />
        </mxCell>
        <mxCell id="10" value="build/wave.csv&#10;每周期记录 valid、x、expected、y、acc&#10;build/ffe.vcd&#10;关键硬件信号波形" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;shadow=0;fillColor=#E8F1FB;strokeColor=#4C78A8;strokeWidth=2;fontFamily=PingFang SC;fontSize=15;fontColor=#203040;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1570" y="445" width="420" height="175" as="geometry" />
